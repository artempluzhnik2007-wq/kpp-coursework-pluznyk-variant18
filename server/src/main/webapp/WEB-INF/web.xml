<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Land Violations Server</display-name>

    <servlet>
        <servlet-name>LandPlotServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.LandPlotServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LandPlotServlet</servlet-name>
        <url-pattern>/api/landplots</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViolationServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.ViolationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViolationServlet</servlet-name>
        <url-pattern>/api/violations</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ObservationServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.ObservationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ObservationServlet</servlet-name>
        <url-pattern>/api/observations</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InspectionTaskServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.InspectionTaskServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InspectionTaskServlet</servlet-name>
        <url-pattern>/api/tasks</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IndicatorServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.IndicatorServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>IndicatorServlet</servlet-name>
        <url-pattern>/api/indicator</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>CsvImportServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.CsvImportServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CsvImportServlet</servlet-name>
        <url-pattern>/api/import</url-pattern>
    </servlet-mapping>



</web-app>
